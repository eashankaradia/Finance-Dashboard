# ── Supabase (required for real data; without it the app runs in demo mode) ──
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only. Lets the price API write the shared price cache table.
# Optional but recommended (saves API calls). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Market data (server only, optional) ──
# Alpha Vantage: UK (.LON) and US prices. Free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Finnhub: US prices with a much higher free allowance. Free key: https://finnhub.io/register
FINNHUB_API_KEY=
